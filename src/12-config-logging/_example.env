# An example .env for 03-layering.ts §2.
#
#   node --env-file=src/12-config-logging/_example.env \
#        src/12-config-logging/03-layering.ts
#
# ⚠ A real .env belongs in .gitignore. This one is checked in ON PURPOSE,
# because it contains nothing secret and exists only to demonstrate the flag.

DEMO_PORT=8080
DEMO_LOG_LEVEL=debug
DEMO_FEATURE=true
